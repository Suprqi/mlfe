# ═══════════════════════════════════════════════════════════════
#  متغيّرات بيئة مَلَفّي — انسخها إلى Vercel اليوم، وإلى خادم
#  الرياض عند الترحيل. لا تضع القيم في هذا الملف ولا في المستودع.
# ═══════════════════════════════════════════════════════════════

# ── الذكاء الاصطناعي ──────────────────────────────────────────
# من console.anthropic.com. مضبوط اليوم على Vercel.
ANTHROPIC_API_KEY=

# ── قاعدة البيانات والحسابات ─────────────────────────────────
# اليوم: Supabase. بعد الترحيل: Postgres على خادم الرياض.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# مفتاح الخدمة. يتجاوز عزل الصفوف، فلا يظهر في المتصفح أبدًا.
# بدونه لا تعمل: نقطة حذف الحساب، وتفعيل الاشتراك بعد الدفع.
# من: Supabase ← Settings ← API ← service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── الدفع ─────────────────────────────────────────────────────
# من: لوحة مويسر ← Dashboard ← API Keys
# ابدأ بـ sk_test_ ثم بدّله بـ sk_live_ بعد اعتماد حساب التاجر.
MOYASAR_SECRET_KEY=

# كلمة سرّ تخترعها أنت، وتضع نفسها في لوحة مويسر ← Webhooks.
# اختيارية لكن بدونها يقبل الخادم أي طلب يدّعي أنه من مويسر
# (يبقى التحقّق الثاني من مويسر مباشرةً قائمًا على أي حال).
MOYASAR_WEBHOOK_TOKEN=

# ── الاشتراك ──────────────────────────────────────────────────
# '1' يحجب مزايا الذكاء الاصطناعي عن منتهي التجربة.
# اتركه مطفأً حتى تنجح أول دفعة حقيقية، وإلا حجبتَ معلمين
# يستعملون التطبيق اليوم بلا سبب.
ENFORCE_SUBSCRIPTION=

# ── جائزة أفضل ملف إنجاز ──────────────────────────────────────
# الباب مغلق ما لم يُضبط الاثنان معًا. الافتراض الآمن هو الإغلاق:
# استقبال ملفات قبل إعلان الجائزة أسوأ من ردّها.
# لا تفتحه قبل اكتمال الميزات الثلاث واستكمال التواريخ في الشروط.
AWARD_OPEN=
# تاريخ الإقفال بصيغة ISO. الخادم يرفض ما يصل بعده.
AWARD_CLOSES_AT=

# ── بعد الترحيل إلى الرياض (SCCC) تُضاف ──────────────────────
# DATABASE_URL=postgres://malaffi:كلمة_السر@127.0.0.1:5432/malaffi
# APP_URL=https://malafi.sa
# APP_KEY=            # يولّده: php artisan key:generate
