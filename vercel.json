{
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/vision.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:token",
      "destination": "/share-view"
    }
  ],
  "headers": [
    {
      "source": "/share-view",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app-v25",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
